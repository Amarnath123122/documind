server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;
  client_max_body_size 1m;  # API bodies are small JSON; files go straight to blob storage

  include /etc/nginx/conf.d/security_headers.inc;

  location /v1/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
  }

  # Server-Sent Events: stream tokens as they arrive.
  location ~ ^/v1/chat/turns/[^/]+/events$ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
  }

  location /assets/ {
    include /etc/nginx/conf.d/security_headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/conf.d/security_headers.inc;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
